# Discord Configuration (Required)
BOT_TOKEN=your_discord_bot_token_here
CHANNEL_ID=123456789012345678
VOICE_CHANNEL_ID=123456789012345678

# Bot Configuration (Optional)
# COMMAND_PREFIX removed - bot now uses slash commands only
SAVE_PATH=./temp_audio

# VoxCPM TTS Configuration (Optional)
VOXCPM_MODEL_PATH=openbmb/VoxCPM-0.5B
VOXCPM_PROMPT_WAV=assets/model.wav
VOXCPM_PROMPT_TEXT=assets/transcript.txt
VOXCPM_CFG_VALUE=2.0
VOXCPM_INFERENCE_STEPS=10
VOXCPM_NORMALIZE=true
VOXCPM_DENOISE=true
VOXCPM_MAX_LENGTH=4096

# Audio Cleanup Configuration (Optional)
AUDIO_CLEANUP_HOURS=24

# Ollama AI Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.7b
OLLAMA_TIMEOUT=30.0
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=1.0
OLLAMA_MAX_RESPONSE_LENGTH=500
OLLAMA_TEMPERATURE=0.7
SYSTEM_PROMPT_FILE=ollama_system_prompt.json

# Memory System Configuration (Optional)
# Master switch for memory features
MEMORY_ENABLED=true

# Database Configuration (Required if memory enabled)
PG_DSN=postgres://ssa:ssa@localhost:5432/ssa
PG_POOL_MIN=2
PG_POOL_MAX=10

# Embedding Configuration (Required if memory enabled)
EMBED_MODEL=nomic-embed-text
EMBED_OLLAMA_URL=http://localhost:11434

# Short-Term Memory Behavior
STM_MAX_TOKENS=2400
STM_KEEP_LAST=2

# Retrieval Configuration
RETRIEVE_TOP_K=6
RECENCY_WINDOW_DAYS=7
BOOST_SIMILARITY=0.7
BOOST_RECENCY=0.2
BOOST_IMPORTANCE=0.1

# Policy Configuration
MEMORY_MIN_IMPORTANCE=2
MEMORY_EXPORT_DIR=./exports
