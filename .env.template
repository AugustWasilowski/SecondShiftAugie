# Second Shift Augie — container env vars
#
# These tune the voice helper. The Discord bot token itself is read from
# the mounted ~/.claude/channels/discord/.env (managed by the Claude Code
# Discord plugin's /discord:configure skill), so it isn't set here.
#
# Copy this file to .env and adjust if needed. Defaults are sane for the
# home-server setup; the only thing you'll typically change is
# AUGIE_GUILD_ID if you want slash commands to register instantly to your
# server instead of waiting up to an hour for Discord's global propagation.

# Where Piper TTS lives. JSON POST endpoint that returns WAV bytes.
AUGIE_PIPER_URL=http://10.0.0.72:5050

# Loopback address the helper's HTTP API binds to. The augie-speak MCP
# server posts to this from inside the container. Don't expose publicly.
AUGIE_HTTP_BIND=127.0.0.1:9876

# Log verbosity for the voice helper. info|debug|warning|error.
AUGIE_LOG_LEVEL=info

# Discord guild (server) ID for guild-scoped slash command registration.
# Compose has Big Shoulder Games (1100479478112735352) baked in as the
# default; set this env var to override for a different server. With a
# guild ID set, /join, /leave, /play appear in that server immediately
# on bot start. Unset = Discord global propagation (~1h on first deploy).
# AUGIE_GUILD_ID=1100479478112735352

# Per-guild idle timeout (seconds). If nobody plays anything for this
# long, the bot leaves the voice channel automatically. 0 disables.
AUGIE_IDLE_LEAVE_SECONDS=600

# Scratch directory inside the container where synthesized WAVs land.
# Mounted from /mnt/storage/shares/augie-tmp on the host.
AUGIE_TMPDIR=/tmp/augie
