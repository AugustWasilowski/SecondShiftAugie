# Development Environment Configuration for SecondShiftAugie
# Copy this file to .env and update with your actual values

# Discord Configuration (Required)
BOT_TOKEN=your_discord_bot_token_here
GUILD_ID=your_guild_id_here
CHANNEL_ID=your_channel_id_here
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Bot Configuration
SAVE_PATH=./temp_audio

# VoxCPM TTS Configuration
VOXCPM_MODEL_PATH=openbmb/VoxCPM-0.5B
VOXCPM_PROMPT_WAV=assets/model.wav
VOXCPM_PROMPT_TEXT=assets/transcript.txt
VOXCPM_CFG_VALUE=2.0
VOXCPM_INFERENCE_STEPS=10
VOXCPM_NORMALIZE=true
VOXCPM_DENOISE=true
VOXCPM_MAX_LENGTH=4096

# Audio Cleanup Configuration
AUDIO_CLEANUP_HOURS=24

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.7b
OLLAMA_TIMEOUT=60.0
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=1.0
OLLAMA_MAX_RESPONSE_LENGTH=500
OLLAMA_TEMPERATURE=0.7
SYSTEM_PROMPT_FILE=ollama_system_prompt.json

# Memory System Configuration - Development Settings
MEMORY_ENABLED=true

# Database Configuration (Local PostgreSQL)
PG_DSN=postgres://ssa:ssa@localhost:5432/ssa_dev
PG_POOL_MIN=1
PG_POOL_MAX=5

# Embedding Configuration (Local Ollama)
EMBED_MODEL=nomic-embed-text
EMBED_OLLAMA_URL=http://localhost:11434

# STM Configuration (Smaller for development)
STM_MAX_TOKENS=1200
STM_KEEP_LAST=2

# Retrieval Configuration (Fewer results for development)
RETRIEVE_TOP_K=3
RECENCY_WINDOW_DAYS=7
BOOST_SIMILARITY=0.7
BOOST_RECENCY=0.2
BOOST_IMPORTANCE=0.1

# Policy Configuration (Lower threshold for development)
MEMORY_MIN_IMPORTANCE=1
MEMORY_EXPORT_DIR=./dev_exports

# Development-specific settings
LOG_LEVEL=DEBUG
MEMORY_LOG_PERFORMANCE=true
MEMORY_LOG_QUERIES=true