# Production Environment Configuration for SecondShiftAugie
# Copy this file to .env and update with your actual values

# Discord Configuration (Required)
BOT_TOKEN=your_production_discord_bot_token_here
GUILD_ID=your_production_guild_id_here
CHANNEL_ID=your_production_channel_id_here
VOICE_CHANNEL_ID=your_production_voice_channel_id_here

# Bot Configuration
SAVE_PATH=/var/lib/ssa/audio

# VoxCPM TTS Configuration
VOXCPM_MODEL_PATH=openbmb/VoxCPM-0.5B
VOXCPM_PROMPT_WAV=assets/model.wav
VOXCPM_PROMPT_TEXT=assets/transcript.txt
VOXCPM_CFG_VALUE=2.0
VOXCPM_INFERENCE_STEPS=10
VOXCPM_NORMALIZE=true
VOXCPM_DENOISE=true
VOXCPM_MAX_LENGTH=4096

# Audio Cleanup Configuration
AUDIO_CLEANUP_HOURS=12

# Ollama AI Configuration
OLLAMA_BASE_URL=https://ollama.internal.example.com
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120.0
OLLAMA_MAX_RETRIES=5
OLLAMA_RETRY_DELAY=2.0
OLLAMA_MAX_RESPONSE_LENGTH=750
OLLAMA_TEMPERATURE=0.6
SYSTEM_PROMPT_FILE=ollama_system_prompt.json

# Memory System Configuration - Production Settings
MEMORY_ENABLED=true

# Database Configuration (Production PostgreSQL with SSL)
PG_DSN=postgres://ssa_user:secure_password@db.example.com:5432/ssa_prod?sslmode=require&application_name=ssa_bot
PG_POOL_MIN=5
PG_POOL_MAX=20

# Embedding Configuration (Production Ollama)
EMBED_MODEL=mxbai-embed-large
EMBED_OLLAMA_URL=https://ollama.internal.example.com

# STM Configuration (Production optimized)
STM_MAX_TOKENS=2400
STM_KEEP_LAST=2

# Retrieval Configuration (Production optimized)
RETRIEVE_TOP_K=6
RECENCY_WINDOW_DAYS=14
BOOST_SIMILARITY=0.8
BOOST_RECENCY=0.15
BOOST_IMPORTANCE=0.05

# Policy Configuration (Higher threshold for production)
MEMORY_MIN_IMPORTANCE=2
MEMORY_EXPORT_DIR=/var/lib/ssa/exports

# Production-specific settings
LOG_LEVEL=INFO
MEMORY_LOG_PERFORMANCE=true
MEMORY_LOG_QUERIES=false

# Health check configuration
HEALTH_CHECK_INTERVAL=300
MEMORY_HEALTH_ENDPOINT=/health/memory

# Security settings
MEMORY_EXPORT_RETENTION_DAYS=30
MEMORY_MAX_EXPORT_SIZE_MB=100